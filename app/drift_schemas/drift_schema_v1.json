  "fixed_sql": [
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"updated_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP), \"remote_id\" TEXT NULL, \"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"story\" TEXT NOT NULL DEFAULT '', \"created_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "character_cards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"character_cards\" (\"updated_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP), \"remote_id\" TEXT NULL, \"id\" TEXT NOT NULL, \"project_id\" TEXT NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"appearance\" TEXT NOT NULL DEFAULT '', \"outfit\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "shots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shots\" (\"updated_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP), \"remote_id\" TEXT NULL, \"id\" TEXT NOT NULL, \"project_id\" TEXT NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"sort_order\" INTEGER NOT NULL, \"shot_size\" TEXT NOT NULL, \"scene\" TEXT NOT NULL, \"dialogue\" TEXT NOT NULL DEFAULT '', \"reason\" TEXT NOT NULL DEFAULT '', \"character_ids\" TEXT NOT NULL DEFAULT '[]', \"status\" TEXT NOT NULL DEFAULT 'pending', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "generations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"generations\" (\"updated_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP), \"remote_id\" TEXT NULL, \"id\" TEXT NOT NULL, \"shot_id\" TEXT NOT NULL REFERENCES shots (id) ON DELETE CASCADE, \"platform\" TEXT NOT NULL, \"prompt\" TEXT NOT NULL, \"result_note\" TEXT NOT NULL DEFAULT '', \"picked\" INTEGER NOT NULL DEFAULT 0 CHECK (\"picked\" IN (0, 1)), \"created_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "key_values",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"key_values\" (\"entry_key\" TEXT NOT NULL, \"entry_value\" TEXT NOT NULL, PRIMARY KEY (\"entry_key\"));"
        }
      ]
    },
