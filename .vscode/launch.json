{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "app（本机服务）",
      "cwd": "app",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "app（真机，改成电脑的局域网 IP）",
      "cwd": "app",
      "request": "launch",
      "type": "dart",
      "args": ["--dart-define=API_BASE_URL=http://192.168.1.100:3000/"]
    }
  ]
}
